@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "My orders";
}
<h1>My orders</h1>

@if (Model.Count == 0)
{
    <p>You have no orders yet.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Order</th><th>Description</th><th>Placed</th><th>Status</th><th>Total</th></tr>
        </thead>
        <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@order.Id">#@order.Id</a></td>
                <td>@order.Description</td>
                <td>@order.PlacedOn.ToString("yyyy-MM-dd")</td>
                <td>@order.Status</td>
                <td>@order.Total.ToString("C")</td>
            </tr>
        }
        </tbody>
    </table>
}
